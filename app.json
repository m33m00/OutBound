{
  "expo": {
    "name": "OutBound",
    "slug": "outbound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "outbound",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D3D84",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f8fb",
          "image": "./assets/images/splash-wordmark.png",
          "imageWidth": 192,
          "dark": {
            "backgroundColor": "#0b1119",
            "image": "./assets/images/splash-wordmark-dark.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OutBound uses your location to start searches from the nearest airport and to estimate when to leave for it."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
